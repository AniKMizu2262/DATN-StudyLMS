# ==============================
# DEPENDENCIES / THƯ VIỆN PHỤ THUỘC
# ==============================
node_modules/

# ==============================
# ENVIRONMENT / BIẾN MÔI TRƯỜNG
# ==============================
.env
.env.*
!.env.example

# ==============================
# BUILD OUTPUTS / FILE SAU KHI BUILD
# ==============================
dist/
build/
coverage/

# ==============================
# LOGS / NHẬT KÝ
# ==============================
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==============================
# PYTHON / MÔI TRƯỜNG PYTHON
# Dùng nếu sau này bổ sung dịch vụ RAG bằng Python
# ==============================
__pycache__/
*.py[cod]
.venv/
venv/

# ==============================
# EDITOR / TRÌNH SOẠN THẢO
# ==============================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

.idea/
*.suo
*.user

# ==============================
# OPERATING SYSTEM / HỆ ĐIỀU HÀNH
# ==============================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# ==============================
# TEMPORARY AND BACKUP FILES / FILE TẠM
# ==============================
*.tmp
*.bak
*.swp
*.swo
*~

# ==============================
# LOCAL DATABASE AND DATA FILES
# Cẩn thận không commit dữ liệu cá nhân hoặc dữ liệu thử nghiệm
# ==============================
*.sqlite
*.sqlite3
